# Discord
DISCORD_BOT_TOKEN=your-bot-token-here
STAFF_ROLE_IDS=
REGULAR_ROLE_IDS=
STAFF_USER_IDS=
# Channel IDs where the bot is allowed to respond (comma-separated, empty = all channels)
ALLOWED_CHANNEL_IDS=
# Optional boot-time guild approvals (comma-separated). A validated Server setup
# with `bot_active: true` also activates a guild. A validated `bot_active: false`
# keeps its config but overrides this list. Other invited guilds stay silent.
ALLOWED_GUILD_IDS=
# The bot's name, substituted into the persona (config/persona.md) via <bot_name>.
BOT_NAME=Kimi
# Privileged Message Content intent. Apps over 10,000 users must apply for it in
# the Developer Portal and reauthorize yearly. Set False if not yet approved/in a
# reauth gap: plain mentions and replies keep working; the "hey <bot_name>" text
# trigger, thread auto-reply, and discord_text_search do not (keep
# THREAD_HANDOFF_ENABLED off while this is False). Default True.
MESSAGE_CONTENT_INTENT=true

# Members intent. Optional modules may use it for member lifecycle events.
# Enabling this also requires turning on Server Members in the Developer Portal,
# or the gateway rejects the connection. Default False.
MEMBERS_INTENT=false

# Model routing
# Provider profiles, model IDs, role assignments, context windows, and chat
# overrides live in config/models.yaml. Secrets referenced there by api_key_env
# stay in this local .env file.
# Neutral key used by the generic config/models.example.yaml profile. Replace
# that template's placeholder endpoint and model IDs before setting this.
MODEL_API_KEY=
# Optional OpenCode Go subscription key. Also consumed by the Hindsight
# container when that deployment selects it (deploy/hindsight/docker-compose.yml).
OPENCODE_GO_API_KEY=
# Optional RunInfra gateway key for OpenAI-compatible routes.
RUNINFRA_GATEWAY_KEY=
# Anthropic API key (native anthropic profile; api.anthropic.com).
ANTHROPIC_API_KEY=
# xAI Grok key. Only needed when the private config/models.yaml references
# GROK_API_KEY. Leave blank to keep Grok inactive.
GROK_API_KEY=
# Fireworks AI key, for an openai_compat profile pointing at
# https://api.fireworks.ai/inference/v1. Leave blank to keep Fireworks inactive.
FIREWORKS_API_KEY=
# Z.AI GLM Coding Plan key, for an openai_compat profile pointing at the
# dedicated https://api.z.ai/api/coding/paas/v4 endpoint. Do not use the
# pay-as-you-go /api/paas/v4 endpoint when plan quota is intended.
ZAI_API_KEY=
# Kimi Code membership coding-plan key from the Kimi Code Console, for an
# anthropic_compat profile pointing at https://api.kimi.com/coding/v1. Separate
# product from the pay-as-you-go Kimi Open Platform. Leave blank to keep it
# inactive.
KIMI_CODING_API_KEY=
CODEX_TOKEN_FILE=secrets/codex-auth.json
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=high
CODEX_IMAGE_QUALITY=auto
CODEX_IMAGE_FORMAT=png
CODEX_WS_IDLE_TIMEOUT=3000
CODEX_WS_READ_TIMEOUT=120
CODEX_VERBOSE=false
REACT_MAX_ITERATIONS=200
REACT_MAX_TOKENS=65536
# Whole-turn wall-clock deadline for ReAct response turns. Last-resort ceiling only:
# streamed provider calls abort on chunk silence (PROVIDER_STREAM_STALL_TIMEOUT_SECONDS)
# long before this, so a turn only runs long while the model is still producing output.
REACT_TURN_TIMEOUT_SECONDS=3600
# Abort a streamed provider request when its stream goes silent (no headers/chunks)
# for this long; the failover chain then tries the next backend.
PROVIDER_STREAM_STALL_TIMEOUT_SECONDS=90
# Inject a system-prompt onboarding note while a user has fewer than this many prior
# messages with the bot (model is told they're new + may block/report on abuse). 0 disables.
NEW_USER_ONBOARDING_TURNS=5
# Max concurrent in-flight LLM provider calls across all users/channels
LLM_MAX_CONCURRENCY=8
# Whole-turn admission is separate from LLM_MAX_CONCURRENCY: it covers attachment
# reads, moderation, memory, tools, delivery, and persistence too. Capacity is never
# queued; excess requests receive a short retry response.
TURN_MAX_CONCURRENCY=16
TURN_MAX_CONCURRENCY_PER_USER=2
# Sampling temperature for chat providers (openai_compat/openrouter). Leave
# blank to use the endpoint default.
REACT_TEMPERATURE=1.0

# Content moderation (OpenAI omni-moderation; disabled unless enabled + key).
# Use a dedicated OpenAI project key. Do not reuse a chat provider key.
MODERATION_ENABLED=false
MODERATION_API_KEY=
MODERATION_BASE_URL=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_SECONDS=5.0
MODERATION_INPUT_IMAGES=true
MODERATION_OUTPUT_IMAGES=true
# Blank = output moderation applies to all; regular skips output moderation for regular/staff.
MODERATION_OUTPUT_EXEMPT_TIER=
# Sent when the member's own message is blocked.
MODERATION_INPUT_REFUSAL=That message didn't pass my content filter, so I didn't read it. Try rewording it.
# Sent when the bot's generated reply is blocked. The member did nothing wrong.
MODERATION_OUTPUT_REFUSAL=I wrote a reply, but it didn't pass my content filter, so I'm not posting it. Nothing's wrong on your end; try asking a different way.
# Sent when the content check could not run (backend outage, unscreenable file).
# Output fails closed, so during an outage every reply uses this one.
MODERATION_ERROR_REFUSAL=I can't run my content check right now, so I'm holding this one back. Try again in a minute.

# Lifecycle-aware application modules, discovered from installed packages but
# loaded only when named here. Configured modules are required: a missing,
# incompatible, or failed module aborts startup. Module-owned settings are
# documented by each module package.
KIMI_MODULES=

# Discord text search (optional searchable tool)
# Enabled by default when Message Content intent is on. Searches are restricted
# to channels both the requesting member and bot can read. Omitted tool scope
# searches every eligible channel; a CSV tool scope narrows it.
DISCORD_TEXT_SEARCH_ENABLED=true
# Optional comma-separated channel IDs to exclude. Excluding a parent channel
# also excludes its threads.
DISCORD_SEARCH_EXCLUDED_CHANNELS=
# Legacy allowlist setting; leave empty and use DISCORD_SEARCH_EXCLUDED_CHANNELS.
# DISCORD_SEARCH_CHANNELS=
DISCORD_SEARCH_TIMEOUT_SECONDS=30
# Result count (max_results) lives in config/tools/discord_text_search.md.

# Live internet search. Set either key to register the tool; set both to blend
# Exa-first results with Brave LLM Context. A blend call spends two of the ten
# logical provider operations available per user turn. Internal transient HTTP
# retries remain part of the same operation. Page reads require Exa.
EXA_API_KEY=
EXA_API_BASE=https://api.exa.ai
BRAVE_API_KEY=
BRAVE_CONTEXT_URL=https://api.search.brave.com/res/v1/llm/context
INTERNET_SEARCH_BACKEND_TIMEOUT_SECONDS=30
INTERNET_SEARCH_TIMEOUT_SECONDS=45
INTERNET_SEARCH_MAX_RESULTS=10
INTERNET_SEARCH_MAX_BACKEND_CALLS_PER_TURN=10
INTERNET_SEARCH_MAX_OUTPUT_CHARS=24000
INTERNET_SEARCH_SAFESEARCH=moderate
# Optional per-request fallback prices in USD. Leave blank when the provider
# reports an authoritative cost or when this deployment does not know the rate.
EXA_SEARCH_COST_USD=
EXA_CONTENTS_COST_USD=
BRAVE_SEARCH_COST_USD=
# Keep provider endpoint defaults unless using a compatible proxy.

# Wolfram|Alpha computational knowledge. Set the environment-only AppID to
# register the searchable tool; obtain one from developer.wolframalpha.com.
WOLFRAM_ALPHA_APP_ID=
WOLFRAM_ALPHA_TIMEOUT_SECONDS=30
WOLFRAM_ALPHA_MAX_CALLS_PER_TURN=3
WOLFRAM_ALPHA_MAX_OUTPUT_CHARS=6800
# Optional known price in USD per logical call (including its bounded retry)
# for the local paid-usage ledger. Attempted provider calls record the estimate.
WOLFRAM_ALPHA_CALL_COST_USD=

# Stateful YouTube and uploaded-video understanding (optional searchable tool).
# Both values are required for registration. Uploaded Discord/workspace videos
# have fixed 500 MiB and one-hour hard ceilings. GEMINI_API_KEY is an
# environment-only secret; safe per-call controls live in config/tools/video.md.
VIDEO_UNDERSTANDING_ENABLED=false
GEMINI_API_KEY=
# Process-wide interactive Gemini request cap (1-32). Cleanup uses a separate pool.
VIDEO_UNDERSTANDING_MAX_CONCURRENCY=4

# OpenAI image generation and editing (REGULAR-tier core tool). Disabled by
# default. auto prefers the existing Codex OAuth token and falls back to the
# platform API key. Safe per-call knobs live in config/tools/generate_image.md.
IMAGE_GEN_ENABLED=false
IMAGE_GEN_BACKEND=openai
IMAGE_GEN_AUTH_MODE=auto
IMAGE_GEN_API_KEY=
IMAGE_GEN_MAX_CONCURRENCY=1
IMAGE_GEN_TIMEOUT_SECONDS=300

ATTACHMENT_STORE_DIR=data/attachments
ATTACHMENT_MAX_BYTES=8388608
# Aggregate image bytes staged across current/reply/history candidates in one turn.
ATTACHMENT_MAX_TOTAL_BYTES=33554432
# Fallback cleanup for image stages left by a process crash. Normal turns clean up
# immediately; the startup/hourly scan is bounded by the file count below.
ATTACHMENT_ORPHAN_TTL_SECONDS=86400
ATTACHMENT_ORPHAN_SWEEP_INTERVAL_SECONDS=3600
ATTACHMENT_ORPHAN_SWEEP_MAX_FILES=1000
IMAGE_DETAIL=auto
# How many recent channel messages to scan for the newest image (reply/edit context)
RECENT_IMAGE_LOOKBACK=10
# Max newly collected vision images per turn; 0 disables all image input, including
# images retained in conversation history.
MAX_TURN_IMAGES=10

# Hindsight Memory. Self-host with deploy/hindsight/docker-compose.yml (see
# deploy/hindsight/README.md). Point this at wherever your instance listens:
HINDSIGHT_URL=
HINDSIGHT_API_KEY=

# Instance layout: where private operator data lives. The convenient defaults
# are ignored, but production should use durable absolute paths outside the
# application checkout; see docs/instance-data.md.
# CONFIG_DIR=config
# SKILLS_DIR=skills/store

# Operator plugins: explicit comma-separated allowlist of importable module
# paths, each exposing register(ctx) -> None. There is no auto-discovery; see
# docs/plugins.md. Loaded after core tools; a failing plugin is logged and
# skipped, never a boot abort.
# PLUGIN_MODULES=

# Local Storage
DATABASE_PATH=data/bot.db
PERSONAL_SKILLS_DIR=data/personal_skills

# Encryption-at-rest for the bot DB (SQLCipher). Leave empty for plaintext
# sqlite3 (default). When set, the DB is opened through sqlcipher3 and keyed with
# this passphrase. Requires the Linux-only sqlcipher3-binary dependency. Losing
# this key makes an encrypted DB unrecoverable; convert an existing plaintext DB
# with sqlcipher_export (see docs/database.md), do not just set this on it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_ENCRYPTION_KEY=

# User persona overrides (optional searchable tools, REGULAR+ only).
# Turned on by a `persona` role in config/models.yaml, which also picks the model
# that compiles character/persona requests into 13+-appropriate prompt text. No
# role means the tools do not register. See docs/persona.md.
USER_PERSONA_MAX_CHARS=2000
USER_PERSONA_REQUEST_MAX_CHARS=8000
USER_PERSONA_COMPILER_MAX_TOKENS=32000

# User Memory
# The model writes durable current-user facts proactively via remember_user_memory.
# Recall layers injected automatically each responding turn. "observation" is
# Hindsight's consolidated, deduplicated layer; adding the raw "world"/"experience"
# layers re-injects every fact two-to-four times and floods the prompt. Default to
# observation-only; add the raw layers back only if you want the episodic detail.
MEMORY_RECALL_TYPES=observation
# Hindsight recall breadth for automatic recall. Widen for more breadth at prompt cost.
MEMORY_RECALL_BUDGET=mid
MEMORY_RECALL_MAX_TOKENS=2048
# Cap on proactive remember_user_memory writes per turn (bounds memory bloat).
MEMORY_MAX_WRITES_PER_TURN=3
# Auto-retain: background idle-flush of conversation transcripts into each
# memory-enabled participant's Hindsight bank. User memory defaults on;
# /memory opt-out disables it (docs/memory.md).
MEMORY_AUTO_RETAIN_ENABLED=false
MEMORY_AUTO_RETAIN_IDLE_MINUTES=30
MEMORY_AUTO_RETAIN_SWEEP_INTERVAL_SECONDS=300
MEMORY_AUTO_RETAIN_MIN_USER_CHARS=80
MEMORY_AUTO_RETAIN_MAX_CONTENT_CHARS=24000
MEMORY_AUTO_RETAIN_BACKFILL_HORIZON_HOURS=24
MEMORY_AUTO_RETAIN_MAX_FLUSHES_PER_SWEEP=20

# Transcript retention (docs/privacy.md): a background sweep purges whole
# conversations idle longer than this many days (raw SQLite transcript only).
# Distilled Hindsight memory is NOT on this clock (governed by /memory opt-out
# and the /privacy memory-delete path). On by default; the first sweep deletes
# conversations already idle past the window. 0 disables the sweep (keep
# transcripts forever).
TRANSCRIPT_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_SWEEP_INTERVAL_SECONDS=3600

# Privacy consent gate (off by default). When true, a user's first interaction
# posts a one-time accept/decline notice and holds the message until they accept,
# so nothing reaches the third-party LLM provider before consent.
PRIVACY_CONSENT_ENABLED=false
PRIVACY_CONSENT_TITLE=Before we chat: a quick privacy note
PRIVACY_CONSENT_TEXT=I'm powered by a third-party AI provider, so the messages you send me may be transmitted to and logged by that provider. Tap **Accept** to continue. You'll only see this once. Tap **Decline** and I'll ignore this message.
# Seconds the accept/decline buttons stay live before the prompt expires.
PRIVACY_CONSENT_TIMEOUT=300
# Where this deployment publishes its full privacy policy. Empty drops the link
# from the /privacy embed rather than pointing members at a page you do not
# control; the shipped source text is docs/privacy-policy.md.
PRIVACY_POLICY_URL=

# Secrets
SECRETS_FILE=secrets/secrets.yaml

# Script Execution
SCRIPT_DEFAULT_TIMEOUT=1200
SCRIPT_MAX_TIMEOUT=1200
SCRIPT_MAX_CONCURRENCY=2
SCRIPT_OUTPUT_MAX_CHARS=200000
SCRIPT_OUTPUT_MAX_FILES=10
SCRIPT_OUTPUT_MAX_FILE_BYTES=26214400
SCRIPT_OUTPUT_MAX_SCAN_ENTRIES=1000
# Per-process virtual-memory ceiling for sandboxed skill scripts (MiB).
SCRIPT_SANDBOX_MEMORY_MAX_MB=2048
# Per-process CPU-time ceiling. Wall time remains bounded separately above.
SCRIPT_SANDBOX_CPU_SECONDS=300
# Maximum size of any one file a sandboxed process may create (bytes).
SCRIPT_SANDBOX_MAX_FILE_BYTES=104857600
SCRIPT_SANDBOX_MAX_OPEN_FILES=256
# Per-UID process accounting makes a dedicated unprivileged bot user important.
SCRIPT_SANDBOX_MAX_PROCESSES=64
# Private /tmp tmpfs cap for each invocation (MiB).
SCRIPT_SANDBOX_TMPFS_MAX_MB=256

# Workspaces
WORKSPACE_DIR=workspaces
WORKSPACE_FILE_TTL=604800
WORKSPACE_MAX_SIZE_MB=150
WORKSPACE_SWEEP_INTERVAL=300
WORKSPACE_TOOL_MAX_FILE_BYTES=52428800
WORKSPACE_TOOL_MAX_USER_BYTES=157286400
WORKSPACE_TOOL_MAX_READ_BYTES=26214400
# PDFs above this page count are rejected before page text extraction starts.
WORKSPACE_TOOL_MAX_PDF_PAGES=500
WORKSPACE_TOOL_MAX_TEXT_CHARS=65536
WORKSPACE_TOOL_MAX_ATTACHMENTS=5
# Per-file cap for import_attachment (bytes). Raise toward your Discord upload limit (e.g. 100MB) if needed.
WORKSPACE_TOOL_MAX_IMPORT_BYTES=26214400
# Max number of entries a single zip/extract_archive call may handle.
WORKSPACE_TOOL_MAX_ZIP_ENTRIES=10000
# Max total uncompressed bytes extract_archive will write from one archive (bomb guard).
WORKSPACE_TOOL_MAX_EXTRACT_TOTAL_BYTES=157286400
WORKSPACE_TOOL_FETCH_TIMEOUT_SECONDS=30
WORKSPACE_TOOL_MAX_REDIRECTS=5
WORKSPACE_TOOL_DEFAULT_GREP_RESULTS=50
WORKSPACE_TOOL_MAX_GREP_RESULTS=200
WORKSPACE_TOOL_MAX_GREP_CONTEXT=20
WORKSPACE_TOOL_MAX_GREP_LINE_CHARS=1000
WORKSPACE_TOOL_MAX_GREP_PATTERN_CHARS=256
# Wall-clock ceiling (seconds) for the regex matching in one grep_workspace call.
# The regex engine honors this mid-match and releases the GIL, so a hostile pattern
# is bounded instead of pinning the event loop.
WORKSPACE_TOOL_GREP_TIMEOUT_SECONDS=5.0
# Max file paths returned by glob_workspace before truncating.
WORKSPACE_TOOL_GLOB_MAX_RESULTS=200
# Max number of edits multi_edit will apply in one call.
WORKSPACE_TOOL_MULTI_EDIT_MAX_OPS=50
# Max size of a single workspace image view_image will show the model (bytes).
WORKSPACE_TOOL_VIEW_IMAGE_MAX_BYTES=5242880
# Max images view_image will surface to the model per reply.
WORKSPACE_TOOL_VIEW_IMAGE_MAX_PER_TURN=4
# Max number of files+dirs in one workspace. Byte quotas alone leave entry
# count unbounded, and tens of thousands of tiny files make every quota walk,
# grep, and sweep O(entries). New-entry writes past this are refused; existing
# files can still be edited or deleted.
WORKSPACE_TOOL_MAX_ENTRIES=20000

# --- Tool event stream (observability) ---
# Append JSONL events to TOOL_EVENT_LOG_PATH. Content mode can only be set here,
# never from the settings overlay: metadata (the default) logs no payloads at all,
# redacted logs them with credential-like fields and known secrets stripped, and
# full logs everything verbatim, secrets included.
TOOL_EVENT_LOG_ENABLED=false
TOOL_EVENT_LOG_PATH=logs/events.jsonl
TOOL_EVENT_LOG_CONTENT_MODE=metadata
# Cap (bytes) on logged args/result before truncation; flags mark truncated fields.
TOOL_EVENT_LOG_MAX_FIELD_BYTES=8192

# OWNER_USER_ID gates owner_only-registered tools at dispatch.
OWNER_USER_ID=

# Sandboxed code execution (MEMBER+). Linux only; the tool registers only after
# the complete bwrap + seccomp + systemd cgroup profile passes its startup probe.
# Run the bot as a non-root service account, and keep WORKSPACE_DIR on an
# exec-capable filesystem. Network modes require the effective sandbox Python's
# venv/ensurepip support (often python3-venv); CODE_EXEC_VENV_DIR/bin/python3 is
# effective when configured, otherwise CODE_EXEC_PYTHON_BIN is.
# Network modes: none (isolated/offline), host (the host's routes, LAN, and
# loopback; explicit trust tradeoff), or netns (operator-provisioned VPN/network
# namespace with private-target isolation checked at startup). See docs/code-exec.md.
CODE_EXEC_ENABLED=false
CODE_EXEC_NETWORK_MODE=none
CODE_EXEC_PYTHON_BIN=/usr/bin/python3
# Optional package venv mounted read-only; keep it separate from the bot venv.
CODE_EXEC_VENV_DIR=
# Comma-separated additional read-only paths. Never mount paths containing secrets.
CODE_EXEC_EXTRA_RO_BINDS=
CODE_EXEC_BWRAP_BIN=bwrap
CODE_EXEC_PRLIMIT_BIN=prlimit
CODE_EXEC_SYSTEMD_RUN_BIN=systemd-run
CODE_EXEC_SUDO_BIN=sudo
# netns only: root-owned, argument-free helper; namespace-specific resolver; and
# a known-open private endpoint (host or host:port) that must be unreachable.
CODE_EXEC_NETNS_HELPER_BIN=
CODE_EXEC_NETNS_RESOLV_CONF=
CODE_EXEC_NETWORK_PROBE_BLOCKED_IP=
# Per-run and whole-process-tree limits, sized to leave room for real builds.
CODE_EXEC_WALL_TIMEOUT_SECONDS=300
CODE_EXEC_MAX_CPU_SECONDS=240
CODE_EXEC_MAX_MEMORY_MB=3072
CODE_EXEC_MAX_TASKS=256
CODE_EXEC_MAX_TOTAL_MEMORY_MB=2048
CODE_EXEC_CPU_QUOTA_PERCENT=200
CODE_EXEC_TMP_SIZE_MB=512
CODE_EXEC_MAX_FSIZE_MB=128
CODE_EXEC_MAX_OPEN_FILES=1024
CODE_EXEC_MAX_WORKSPACE_FILES=50000
# Full-tree accounting runs before/after each job and every five seconds in flight.
# ENOENT/ESTALE races get four total scan attempts; persistent failures remain fail-closed.
CODE_EXEC_WORKSPACE_QUOTA_POLL_SECONDS=5
CODE_EXEC_WORKSPACE_QUOTA_SCAN_RETRIES=4
CODE_EXEC_MAX_OUTPUT_BYTES=40000
CODE_EXEC_MAX_CONCURRENCY=1
# Per-user allowances for regenerable env dirs (.venv/.pio), outside the doc
# quota. Bytes bound content; entries separately bound zero-byte files/inodes.
CODE_EXEC_ENV_DIR_MAX_MB=2048
CODE_EXEC_ENV_DIR_MAX_FILES=200000
# Rolling seven-day networked-run limit per user. Zero disables; STAFF is exempt.
CODE_EXEC_NETWORK_WEEKLY_LIMIT=100

# Durable background coding agent. Also requires CODE_EXEC_ENABLED=true and a
# roles.coding assignment in config/models.yaml.
CODING_TASKS_ENABLED=false
CODING_TASK_MAX_CONCURRENCY=2
CODING_TASK_MAX_QUEUED_PER_WORKSPACE=3
CODING_TASK_MAX_QUEUED_PER_USER=5
CODING_TASK_MAX_SECONDS=7200
CODING_PROVIDER_CALL_TIMEOUT_SECONDS=600
CODING_JOB_MAX_SECONDS=2700
CODING_JOB_MAX_CPU_SECONDS=2400
CODING_WORKER_STALL_SECONDS=120
CODING_STATUS_MIN_INTERVAL_SECONDS=10
CODING_STOP_CLEANUP_WAIT_SECONDS=10
CODING_TASK_MAX_ITERATIONS=80

# Persistent BetterWright browser plus searchable render_chart/render_diagram (MEMBER+).
# Linux only. The browser keeps one isolated profile per Discord user; visuals
# use separate one-shot offline workers. One BROWSER_ENABLED gate requests both
# after the pinned BetterWright/Mermaid runtime and complete bwrap + seccomp +
# systemd profile pass their startup probes.
# Network modes: host (the bot host's own routes and public identity) or netns
# (the fixed VPN namespace helper, with private-target isolation checked at
# startup and no fallback to host). Visual jobs never use either network mode.
# See docs/browser.md and docs/visual-rendering.md.
BROWSER_ENABLED=false
BROWSER_NETWORK_MODE=host
# Root-owned BetterWright, BetterChromium, and Mermaid runtime from
# deploy/betterwright/install.sh; never inside the checkout. Profiles hold
# authenticated site state: treat them like workspaces.
BROWSER_RUNTIME_DIR=/opt/kimi/betterwright
BROWSER_PROFILES_DIR=data/browser_profiles
BROWSER_BRIDGE_SCRIPT=web_browser/bridge.mjs
BROWSER_BWRAP_BIN=bwrap
BROWSER_PRLIMIT_BIN=prlimit
BROWSER_SYSTEMD_RUN_BIN=systemd-run
BROWSER_SYSTEMCTL_BIN=systemctl
BROWSER_SUDO_BIN=sudo
# netns only: root-owned, argument-free helper; namespace-specific resolver; and
# a known-open private endpoint (host or host:port) that must be unreachable.
BROWSER_NETNS_HELPER_BIN=
BROWSER_NETNS_RESOLV_CONF=
BROWSER_NETWORK_PROBE_BLOCKED_IP=
# Per-call and per-worker deadlines. Visual rendering shares the call deadline.
# A persistent worker closes when idle and is recycled at its maximum lifetime.
BROWSER_CALL_TIMEOUT_SECONDS=30
BROWSER_START_TIMEOUT_SECONDS=20
BROWSER_IDLE_TTL_SECONDS=120
BROWSER_WORKER_MAX_LIFETIME_SECONDS=3600
# Profile retention and size. The TTL is enforced by the same filesystem sweeper
# that ages out workspaces.
BROWSER_PROFILE_TTL_SECONDS=604800
BROWSER_MAX_PROFILE_MB=512
# Also caps each verified visual-rendering PNG.
BROWSER_MAX_SCREENSHOT_BYTES=8388608
# Whole-worker-cgroup and per-process limits.
BROWSER_MAX_TOTAL_MEMORY_MB=2048
BROWSER_MAX_TASKS=256
BROWSER_CPU_QUOTA_PERCENT=200
BROWSER_TMP_SIZE_MB=512
BROWSER_MAX_FSIZE_MB=128
BROWSER_MAX_OPEN_FILES=1024
# What every page sees. Keep these consistent with where the chosen network mode
# actually egresses.
BROWSER_TIMEZONE=UTC
BROWSER_LOCALE=en-US

# --- Thread handoff ---
# Lets the model move a conversation into a Discord thread it creates
# (move_to_thread) and keep responding there without mentions; leave_thread
# sends a final reply, then locks and archives the managed thread. Close/pause/
# resume requests are accepted only from the handoff initiator, configured STAFF,
# or someone with effective Discord Manage Threads permission. The bot needs the
# Create Public Threads, Send Messages in Threads, and Manage Threads permissions.
# See docs/thread-handoff.md. No external dependency, so this
# defaults on; turn it off to keep the bot out of threads entirely.
THREAD_HANDOFF_ENABLED=true

# One-time optional model hint after this many substantive tool actions in an
# eligible channel turn. Planning/thread-control calls do not count. The hint is
# appended to the live ReAct suffix without changing tool schemas; 0 disables it.
THREAD_HANDOFF_SUGGEST_AFTER_TOOL_CALLS=5

# Auto-handoff backstop: when the model does NOT thread but produces a long reply
# in a channel that opted in via frontmatter (auto_thread_min_lines /
# auto_thread_min_chars in config/channels/<id>.md), move the reply into a new
# thread automatically. Requires THREAD_HANDOFF_ENABLED=true. Successful handoffs
# react to the parent message with 🧵.
THREAD_AUTO_HANDOFF_ENABLED=false

# --- ReAct-loop context compaction ---
# Summarize stale in-loop tool history when a single turn's projected request
# approaches the model window. Free on normal turns (the trigger never fires).
# Summarizer model/provider is roles.compaction in config/models.yaml. Set that
# model entry's context_window to drive the startup capacity warning.
COMPACTION_TRIGGER_TOKENS=120000
COMPACTION_KEEP_RECENT_ITERATIONS=3
COMPACTION_KEEP_RECENT_TOKENS=50000
COMPACTION_MAX_TOKENS=32768
COMPACTION_MAX_ITERATION_TOOL_OUTPUT_TOKENS=48000
COMPACTION_API_KEY=
