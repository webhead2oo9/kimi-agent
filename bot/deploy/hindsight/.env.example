# Copy to .env and replace every placeholder. The real file is ignored.
# Keep these on loopback when the bot shares this host. For a bot on another
# host, bind only the API to the Docker host's trusted LAN/VPN address and
# restrict that port to the bot with the host firewall. Keep the Control Plane
# local unless it is protected by an authenticating proxy.
HINDSIGHT_API_BIND_ADDRESS=127.0.0.1
HINDSIGHT_CONTROL_BIND_ADDRESS=127.0.0.1

HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_BASE_URL=https://memory-llm.example.invalid/v1
HINDSIGHT_LLM_API_KEY=
HINDSIGHT_LLM_MODEL=provider/memory-model
